{
  "name": "@ngsignal/mutation",
  "version": "0.1.0",
  "description": "Low-level Signals primitive for mutations (POST/PUT/DELETE), designed to complement resource()/httpResource()",
  "keywords": [
    "angular",
    "signals",
    "mutation",
    "resource",
    "http",
    "reactive"
  ],
  "license": "MIT",
  "author": "Erwan Raulo <erwan.raulo@outlook.fr>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngsignal/mutation.git"
  },
  "homepage": "https://github.com/ngsignal/mutation#readme",
  "bugs": {
    "url": "https://github.com/ngsignal/mutation/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0 || ^22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.spec.json",
    "check:exports": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
